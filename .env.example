# ══════════════════════════════════════════════════════════════════
#  GEM Template — Environment Variables
#  Copy this file to .env.local and fill in your values.
#  Never commit .env.local to git.
# ══════════════════════════════════════════════════════════════════

# ── Required ──────────────────────────────────────────────────────
# WhatsApp target number for the lead redirect.
# Digits only — no +, spaces, or dashes.
# Format: country code + number (e.g. Germany = 49 + mobile number)
WHATSAPP_NUMBER=4915123456789

# ── Optional: Email pipeline ──────────────────────────────────────
# Uncomment the Resend block in src/routes/+page.server.ts to activate.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# FROM_EMAIL=anfrage@ihre-domain.de
# TO_EMAIL=info@ihre-domain.de
